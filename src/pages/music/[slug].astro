---
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import YouTubePlayer from '../../components/YouTubePlayer.astro';
import { getMusic, href } from '../../data';
import { musicLinks } from '../../music-links';

export async function getStaticPaths() {
  return (await getMusic()).map((track) => ({ params: { slug: track.data.slug }, props: { track } }));
}

interface Props { track: CollectionEntry<'music'>; }
const { track } = Astro.props;
const { data } = track;
const { spotify, youtube, suno, embed } = musicLinks(data);
const links = [
  { label: 'Spotify', url: spotify },
  { label: 'YouTube', url: youtube },
  { label: 'Suno', url: suno },
].filter(({ url }) => url);
---
<Layout title={data.title} description={data.summary} section="music">
  <a class="text-link back" href={href('music/')}>楽曲一覧に戻る</a>
  <article>
    {embed && (
      <div class="release-player">
        <YouTubePlayer src={embed} title={data.title} />
      </div>
    )}
    <header class:list={['release-heading', { 'release-with-video': embed, 'release-without-cover': !data.cover }]}>
      {data.cover && <div class="track-art" transition:name={`cover-${data.slug}`}><img src={href(data.cover)} alt={data.coverAlt} width="640" height="640" /></div>}
      <div>
        {data.sample && <span class="sample">サンプル</span>}
        <h1 class="song-title">{data.title}</h1>
        {data.summary && <p class="release-summary">{data.summary}</p>}
        {links.length > 0 && <nav class="link-list" aria-label="配信リンク">{links.map(({ label, url }) => <a class="pill" href={url} target="_blank" rel="noopener noreferrer">{label}</a>)}</nav>}
      </div>
    </header>
  </article>
</Layout>

<style>
  .release-player {
    margin-bottom: clamp(1.25rem, 4vw, 2rem);
  }

  .release-with-video {
    grid-template-columns: clamp(5rem, 15vw, 9rem) minmax(0, 1fr);
    gap: clamp(.75rem, 3vw, 1.75rem);
    align-items: start;
  }

  .release-without-cover { grid-template-columns: minmax(0, 1fr); }
  .release-summary { max-width: 64ch; white-space: pre-line; }

  @media (max-width: 42rem) {
    .release-with-video { grid-template-columns: minmax(0, 1fr); }
    .release-with-video .track-art { width: min(100%, 8rem); }
  }
</style>
