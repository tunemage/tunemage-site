---
import { render, type CollectionEntry } from 'astro:content';
import { displayDate, href } from '../data';
interface Props { events: CollectionEntry<'live'>[]; compact?: boolean; }
const { events, compact = false } = Astro.props;
const entries = await Promise.all(events.map(async (entry) => ({ ...entry, ...(await render(entry)) })));
---
<div class="event-list">
  {entries.map(({ data, Content }) => (
    <article class:list={['event', { compact }]}>
      <time datetime={data.date}>{displayDate(data.date)}</time>
      {!compact && data.image && <img src={href(data.image)} alt={data.imageAlt} loading="lazy" decoding="async" width="640" height="640" />}
      <div>
        <h3>{data.title}</h3>
        <p class="muted">{data.venue}{data.sample && ' · サンプル'}</p>
        {!compact && <div class="prose"><Content /></div>}
        {!compact && data.url && <a class="text-link" href={data.url} target="_blank" rel="noopener noreferrer">イベント詳細</a>}
      </div>
    </article>
  ))}
</div>
