---
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getProfile, href } from '../data';
import '../styles/global.css';
import '../styles/site.css';

interface Props { title?: string; description?: string; section?: 'home' | 'music' | 'live'; }
const { title, description, section } = Astro.props;
const profile = await getProfile();
const nav = [
  { id: 'home', label: 'Home', url: href() },
  { id: 'music', label: 'Music', url: href('music/') },
  { id: 'live', label: 'Live', url: href('live/') },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} | ${profile.name}` : profile.name}</title>
    <meta name="description" content={description || profile.bio} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (root.classList.contains('dark') || root.classList.contains('light')) return;
        let theme = 'dark';
        try { if (localStorage.getItem('theme') === 'light') theme = 'light'; } catch {}
        root.classList.add(theme);
        root.style.colorScheme = theme;
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header wrap">
      <a class="wordmark" href={href()}>{profile.name}<span aria-hidden="true">.</span></a>
      <nav aria-label="メイン">
        {nav.map((item) => <a href={item.url} aria-current={section === item.id ? 'page' : undefined}>{item.label}</a>)}
        <a href={href('#contact')}>Contact</a>
      </nav>
      <ThemeToggle />
    </header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="wrap site-footer">
      <span>© {profile.name}</span>
      <a href="https://github.com/EmaSuriano/astro-frame-shift">Astro Frame Shift by Ema Suriano</a>
    </footer>
  </body>
</html>
